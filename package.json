{
  "name": "stellar-postage",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "build": "pnpm --filter './packages/**' build && pnpm --filter './apps/**' --filter './services/**' build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:integration": "pnpm -r run test:integration",
    "db:migrate": "pnpm --filter @stellar-postage/api run db:migrate",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.3.3",
    "typescript": "5.5.4"
  },
  "pnpm": {
    "patchedDependencies": {
      "pg-mem@3.0.14": "patches/pg-mem@3.0.14.patch"
    }
  }
}
